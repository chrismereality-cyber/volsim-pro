import logging
from datetime import datetime, timezone

from src.services.portfolio_service import portfolio_service

logger = logging.getLogger("volsim.risk_service")


class RiskEngineService:
    """
    Production Risk Engine Service.

    This service is the execution-time risk authority.

    Responsibilities:
    - drawdown monitoring
    - daily loss protection
    - risk-per-trade calculation
    - margin usage monitoring
    - liquidation protection
    - maximum exposure / volume protection
    - order approval / rejection

    It does not execute trades.
    It only determines whether execution is permitted.
    """

    # ------------------------------------------------------------------
    # Authoritative risk configuration
    # ------------------------------------------------------------------

    RISK_PER_TRADE_PERCENT = 1.0
    MAX_DAILY_DRAWDOWN_PERCENT = 5.0

    # Maximum raw position volume remains a secondary safety ceiling.
    # Monetary risk must be checked separately by the execution pipeline.
    MAX_POSITION_SIZE = 2.0

    LIQUIDATION_DRAWDOWN_PERCENT = 10.0
    LIQUIDATION_MARGIN_USAGE_PERCENT = 80.0

    ALLOWED_SYMBOLS = {
        "XAUUSDm",
        "EURUSD",
        "GBPUSD",
    }

    def __init__(self):
        self._last_snapshot = None

    # ------------------------------------------------------------------
    # Portfolio state
    # ------------------------------------------------------------------

    def _portfolio_snapshot(self):
        try:
            state = portfolio_service.snapshot()

            if not isinstance(state, dict):
                return {}

            return state

        except Exception as exc:
            logger.exception(
                "Unable to obtain portfolio state: %s",
                exc,
            )
            return {}

    # ------------------------------------------------------------------
    # Numeric helper
    # ------------------------------------------------------------------

    @staticmethod
    def _float(value, default=0.0):
        try:
            return float(value or default)
        except (TypeError, ValueError):
            return float(default)

    # ------------------------------------------------------------------
    # Daily loss
    # ------------------------------------------------------------------

    def _calculate_daily_loss(self, portfolio):
        """
        Determine the available daily P/L value exposed by the portfolio.

        Supported fields are intentionally conservative so the risk engine
        can work with the existing portfolio implementation without creating
        another source of truth.

        Priority:
            daily_loss
            daily_pnl
            realized_pl + floating_pl

        A positive daily P/L is treated as zero loss.
        """

        explicit_daily_loss = portfolio.get("daily_loss")

        if explicit_daily_loss is not None:
            loss = self._float(explicit_daily_loss)

            return max(
                0.0,
                round(loss, 2),
            )

        daily_pnl = portfolio.get("daily_pnl")

        if daily_pnl is not None:
            pnl = self._float(daily_pnl)

            return max(
                0.0,
                round(-pnl, 2),
            )

        realized_pl = self._float(
            portfolio.get(
                "realized_pl",
                0.0,
            )
        )

        floating_pl = self._float(
            portfolio.get(
                "floating_pl",
                0.0,
            )
        )

        combined_pnl = realized_pl + floating_pl

        return max(
            0.0,
            round(-combined_pnl, 2),
        )

    # ------------------------------------------------------------------
    # Risk snapshot
    # ------------------------------------------------------------------

    def snapshot(self):
        try:
            portfolio = self._portfolio_snapshot()

            balance = self._float(
                portfolio.get(
                    "balance",
                    0.0,
                )
            )

            equity = self._float(
                portfolio.get(
                    "equity",
                    0.0,
                )
            )

            margin = self._float(
                portfolio.get(
                    "margin",
                    0.0,
                )
            )

            exposure = self._float(
                portfolio.get(
                    "exposure",
                    0.0,
                )
            )

            # ----------------------------------------------------------
            # Account drawdown
            # ----------------------------------------------------------

            if balance > 0:
                current_drawdown = max(
                    0.0,
                    round(
                        (
                            (balance - equity)
                            / balance
                        ) * 100.0,
                        2,
                    ),
                )
            else:
                current_drawdown = 0.0

            # ----------------------------------------------------------
            # Margin usage
            # ----------------------------------------------------------

            if equity > 0:
                margin_usage = round(
                    (margin / equity) * 100.0,
                    2,
                )
            else:
                margin_usage = 0.0

            # ----------------------------------------------------------
            # Dynamic monetary limits
            # ----------------------------------------------------------

            risk_per_trade_amount = round(
                equity
                * (
                    self.RISK_PER_TRADE_PERCENT
                    / 100.0
                ),
                2,
            )

            daily_loss_limit = round(
                equity
                * (
                    self.MAX_DAILY_DRAWDOWN_PERCENT
                    / 100.0
                ),
                2,
            )

            daily_loss = self._calculate_daily_loss(
                portfolio
            )

            # ----------------------------------------------------------
            # Protection states
            # ----------------------------------------------------------

            drawdown_breach = (
                current_drawdown
                >= self.MAX_DAILY_DRAWDOWN_PERCENT
            )

            daily_loss_breach = (
                daily_loss_limit > 0
                and daily_loss >= daily_loss_limit
            )

            liquidation_warning = (
                current_drawdown
                >= self.LIQUIDATION_DRAWDOWN_PERCENT
                or
                margin_usage
                >= self.LIQUIDATION_MARGIN_USAGE_PERCENT
            )

            circuit_breaker_active = (
                drawdown_breach
                or
                daily_loss_breach
                or
                liquidation_warning
            )

            status = (
                "BLOCKED"
                if circuit_breaker_active
                else "ACTIVE"
            )

            result = {
                "balance": balance,
                "equity": equity,

                "risk_per_trade":
                    self.RISK_PER_TRADE_PERCENT,

                "risk_per_trade_amount":
                    risk_per_trade_amount,

                "maximum_allowed_drawdown":
                    self.MAX_DAILY_DRAWDOWN_PERCENT,

                "current_drawdown":
                    current_drawdown,

                "daily_loss":
                    daily_loss,

                "daily_loss_limit":
                    daily_loss_limit,

                "daily_loss_limit_percent":
                    self.MAX_DAILY_DRAWDOWN_PERCENT,

                "margin_usage":
                    margin_usage,

                "exposure":
                    exposure,

                "max_position_size":
                    self.MAX_POSITION_SIZE,

                "value_at_risk":
                    0.0,

                "hedging_signals":
                    [],

                "liquidation_warning":
                    liquidation_warning,

                "circuit_breaker_active":
                    circuit_breaker_active,

                "status":
                    status,

                "last_update":
                    datetime.now(
                        timezone.utc
                    ).timestamp(),
            }

            self._last_snapshot = result

            return result

        except Exception as exc:
            logger.exception(
                "Risk snapshot failure: %s",
                exc,
            )

            result = {
                "balance": 0.0,
                "equity": 0.0,

                "risk_per_trade":
                    self.RISK_PER_TRADE_PERCENT,

                "risk_per_trade_amount":
                    0.0,

                "maximum_allowed_drawdown":
                    self.MAX_DAILY_DRAWDOWN_PERCENT,

                "current_drawdown":
                    0.0,

                "daily_loss":
                    0.0,

                "daily_loss_limit":
                    0.0,

                "daily_loss_limit_percent":
                    self.MAX_DAILY_DRAWDOWN_PERCENT,

                "margin_usage":
                    0.0,

                "exposure":
                    0.0,

                "max_position_size":
                    self.MAX_POSITION_SIZE,

                "value_at_risk":
                    0.0,

                "hedging_signals":
                    [],

                "liquidation_warning":
                    False,

                "circuit_breaker_active":
                    True,

                "status":
                    "ERROR",

                "error":
                    str(exc),
            }

            self._last_snapshot = result

            return result

    # ------------------------------------------------------------------
    # Execution approval
    # ------------------------------------------------------------------

    def approve_order(self, order_request: dict):
        """
        Validate an order against the current authoritative risk state.

        This method does not execute trades.

        It returns a structured approval decision for the execution service.
        """

        if not isinstance(order_request, dict):
            return {
                "approved": False,
                "reason": "Invalid order request",
            }

        state = self.snapshot()

        # --------------------------------------------------------------
        # Global circuit breaker
        # --------------------------------------------------------------

        if state["circuit_breaker_active"]:
            return {
                "approved": False,
                "reason": "Risk circuit breaker active",
                "risk_state": state,
            }

        # --------------------------------------------------------------
        # Drawdown protection
        # --------------------------------------------------------------

        if (
            state["current_drawdown"]
            >= state["maximum_allowed_drawdown"]
        ):
            return {
                "approved": False,
                "reason": "Maximum drawdown exceeded",
                "risk_state": state,
            }

        # --------------------------------------------------------------
        # Daily loss protection
        # --------------------------------------------------------------

        if (
            state["daily_loss_limit"] > 0
            and
            state["daily_loss"]
            >= state["daily_loss_limit"]
        ):
            return {
                "approved": False,
                "reason": "Daily loss limit exceeded",
                "risk_state": state,
            }

        # --------------------------------------------------------------
        # Liquidation protection
        # --------------------------------------------------------------

        if state["liquidation_warning"]:
            return {
                "approved": False,
                "reason": "Liquidation risk active",
                "risk_state": state,
            }

        # --------------------------------------------------------------
        # Symbol validation
        # --------------------------------------------------------------

        symbol = order_request.get("symbol")

        if not symbol:
            return {
                "approved": False,
                "reason": "Missing symbol",
            }

        if symbol not in self.ALLOWED_SYMBOLS:
            return {
                "approved": False,
                "reason": "Symbol not allowed",
            }

        # --------------------------------------------------------------
        # Volume validation
        # --------------------------------------------------------------

        volume = self._float(
            order_request.get(
                "volume",
                0.0,
            )
        )

        if volume <= 0:
            return {
                "approved": False,
                "reason": "Missing or invalid volume",
            }

        if volume > self.MAX_POSITION_SIZE:
            return {
                "approved": False,
                "reason": "Maximum position size exceeded",
                "maximum_position_size":
                    self.MAX_POSITION_SIZE,
                "requested_volume":
                    volume,
            }

        # --------------------------------------------------------------
        # Optional monetary risk validation
        # --------------------------------------------------------------

        estimated_risk = order_request.get(
            "estimated_risk"
        )

        if estimated_risk is not None:

            estimated_risk = self._float(
                estimated_risk
            )

            allowed_risk = self._float(
                state["risk_per_trade_amount"]
            )

            if (
                allowed_risk > 0
                and
                estimated_risk > allowed_risk
            ):
                return {
                    "approved": False,
                    "reason":
                        "Estimated trade risk exceeds risk-per-trade limit",
                    "estimated_risk":
                        estimated_risk,
                    "allowed_risk":
                        allowed_risk,
                }

        # --------------------------------------------------------------
        # Approved
        # --------------------------------------------------------------

        return {
            "approved": True,

            "reason":
                "Risk limits acceptable",

            "risk_score":
                0,

            "checks": {
                "drawdown":
                    "PASS",

                "daily_loss":
                    "PASS",

                "liquidation":
                    "PASS",

                "symbol":
                    "PASS",

                "volume":
                    "PASS",

                "trade_risk":
                    "PASS",
            },

            "risk_state": state,
        }


risk_engine_service = RiskEngineService()
