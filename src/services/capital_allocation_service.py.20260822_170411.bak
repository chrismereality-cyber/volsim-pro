import time
from typing import Optional


class CapitalAllocationService:
    """
    Capital Allocation Engine.

    Policy:
        70% -> productive trading equity
        30% -> immutable vault reserve

    Responsibilities:
        - Maintain allocation policy
        - Track equity high-water mark
        - Calculate productive equity allocation
        - Calculate reserve/vault allocation
        - Calculate pending vault allocation
        - Expose allocation state

    Does NOT own:
        - trade execution
        - risk approval
        - OMS
        - blockchain transfers
        - portfolio calculations
        - counter-trend logic
    """

    TRADING_EQUITY_PERCENTAGE = 70.0
    VAULT_PERCENTAGE = 30.0

    ALLOCATION_PROFILE = "CORE_SATELLITE_70_30"

    def __init__(self):

        self.high_water_mark = 0.0

        self.total_growth_observed = 0.0

        self.total_vault_allocated = 0.0

        self.pending_vault_allocation = 0.0

        self.last_equity = 0.0

        self.last_allocation_time: Optional[float] = None

        self.status = "ONLINE"

    # --------------------------------------------------------------
    # Equity observation
    # --------------------------------------------------------------

    def observe_equity(self, equity: float):

        equity = max(
            float(equity or 0.0),
            0.0
        )

        self.last_equity = round(
            equity,
            2
        )

        #
        # Establish initial high-water mark.
        #
        if self.high_water_mark <= 0.0:

            self.high_water_mark = round(
                equity,
                2
            )

            return

        #
        # Only NEW equity growth above the previous
        # high-water mark becomes eligible for allocation.
        #
        if equity > self.high_water_mark:

            growth = round(
                equity - self.high_water_mark,
                2
            )

            vault_growth = round(
                growth
                * (
                    self.VAULT_PERCENTAGE
                    / 100.0
                ),
                2
            )

            self.total_growth_observed = round(
                self.total_growth_observed + growth,
                2
            )

            self.pending_vault_allocation = round(
                self.pending_vault_allocation
                + vault_growth,
                2
            )

            #
            # Move HWM to the new equity level.
            #
            self.high_water_mark = round(
                equity,
                2
            )

            self.last_allocation_time = time.time()

    # --------------------------------------------------------------
    # Allocation calculation
    # --------------------------------------------------------------

    def calculate_allocation(
        self,
        equity: float
    ):

        equity = max(
            float(equity or 0.0),
            0.0
        )

        trading_equity = round(
            equity
            * (
                self.TRADING_EQUITY_PERCENTAGE
                / 100.0
            ),
            2
        )

        vault_equity = round(
            equity
            * (
                self.VAULT_PERCENTAGE
                / 100.0
            ),
            2
        )

        return {

            "profile":
                self.ALLOCATION_PROFILE,

            "trading_equity_percentage":
                self.TRADING_EQUITY_PERCENTAGE,

            "vault_percentage":
                self.VAULT_PERCENTAGE,

            "trading_equity":
                trading_equity,

            "vault_equity":
                vault_equity,

        }

    # --------------------------------------------------------------
    # Snapshot
    # --------------------------------------------------------------

    def snapshot(
        self,
        equity: float = 0.0
    ):

        self.observe_equity(
            equity
        )

        allocation = self.calculate_allocation(
            equity
        )

        return {

            "status":
                self.status,

            "profile":
                self.ALLOCATION_PROFILE,

            "trading_equity_percentage":
                self.TRADING_EQUITY_PERCENTAGE,

            "vault_percentage":
                self.VAULT_PERCENTAGE,

            "equity":
                round(
                    float(equity or 0.0),
                    2
                ),

            "trading_equity":
                allocation[
                    "trading_equity"
                ],

            "vault_equity":
                allocation[
                    "vault_equity"
                ],

            "high_water_mark":
                round(
                    self.high_water_mark,
                    2
                ),

            "total_growth_observed":
                round(
                    self.total_growth_observed,
                    2
                ),

            "pending_vault_allocation":
                round(
                    self.pending_vault_allocation,
                    2
                ),

            "total_vault_allocated":
                round(
                    self.total_vault_allocated,
                    2
                ),

            "last_equity":
                round(
                    self.last_equity,
                    2
                ),

            "last_allocation_time":
                self.last_allocation_time,

        }

    # --------------------------------------------------------------
    # Allocation settlement
    # --------------------------------------------------------------

    def mark_vault_allocation_settled(
        self,
        amount: float
    ):

        amount = max(
            float(amount or 0.0),
            0.0
        )

        settled = min(
            amount,
            self.pending_vault_allocation
        )

        self.pending_vault_allocation = round(
            self.pending_vault_allocation
            - settled,
            2
        )

        self.total_vault_allocated = round(
            self.total_vault_allocated
            + settled,
            2
        )

        return {

            "settled":
                round(settled, 2),

            "pending_vault_allocation":
                round(
                    self.pending_vault_allocation,
                    2
                ),

            "total_vault_allocated":
                round(
                    self.total_vault_allocated,
                    2
                ),

        }


capital_allocation_service = (
    CapitalAllocationService()
)
