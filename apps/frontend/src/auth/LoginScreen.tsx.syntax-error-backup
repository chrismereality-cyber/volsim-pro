const ForexCandleField: React.FC<{
  compact?: boolean;
}> = ({ compact = false }) => {
  const candles = compact
    ? FOREX_CANDLES.slice(42)
    : FOREX_CANDLES;

  const chartWidth = compact ? 760 : 1600;
  const chartHeight = compact ? 420 : 760;

  const candleWidth = compact ? 11 : 15;
  const candleStep = chartWidth / candles.length;

  const minPrice = 45;
  const maxPrice = 215;

  const scaleY = (price: number) =>
    chartHeight -
    ((price - minPrice) / (maxPrice - minPrice)) * chartHeight;

  return (
    <svg
      className={`vs-forex-candles ${
        compact
          ? 'vs-forex-candles-compact'
          : 'vs-forex-candles-unified'
      }`}
      viewBox={`0 0 ${chartWidth} ${chartHeight}`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <filter
          id={compact ? 'forexGlowCompact' : 'forexGlowUnified'}
          x="-100%"
          y="-100%"
          width="300%"
          height="300%"
        >
          <feGaussianBlur
            stdDeviation={compact ? 1.25 : 1.7}
            result="blur"
          />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      {candles.map((candle, index) => {
        const baseX =
          index * candleStep + candleStep / 2;

        const openY = scaleY(candle.open);
        const closeY = scaleY(candle.close);
        const highY = scaleY(candle.high);
        const lowY = scaleY(candle.low);

        const bullish = candle.close >= candle.open;

        /*
         * IMPORTANT:
         * The candles remain vertically oriented.
         *
         * Their X position increases normally while their Y position
         * receives a progressive upward offset. This creates the
         * requested "/" projection without rotating the candles.
         */
        const diagonalRise = compact
          ? (index / Math.max(candles.length - 1, 1)) * 245
          : 0;

        const centerX = baseX;
        const shiftedOpenY = openY - diagonalRise;
        const shiftedCloseY = closeY - diagonalRise;
        const shiftedHighY = highY - diagonalRise;
        const shiftedLowY = lowY - diagonalRise;

        const x = centerX - candleWidth / 2;

        const bodyTop = Math.min(
          shiftedOpenY,
          shiftedCloseY
        );

        const bodyHeight = Math.max(
          Math.abs(shiftedCloseY - shiftedOpenY),
          compact ? 5 : 5
        );

        return (
          <g
            key={`${
              compact ? 'diagonal' : 'main'
            }-forex-candle-${index}`}
            opacity={0.95 + (index % 4) * 0.012}
          >
            <line
              x1={centerX}
              y1={shiftedHighY}
              x2={centerX}
              y2={shiftedLowY}
              stroke={
                bullish
                  ? '#22D4FF'
                  : '#3B83A7'
              }
              strokeWidth={
                compact ? 1.25 : 1.35
              }
              filter={`url(#${
                compact
                  ? 'forexGlowCompact'
                  : 'forexGlowUnified'
              })`}
            />

            <rect
              x={x}
              y={bodyTop}
              width={candleWidth}
              height={bodyHeight}
              rx="1"
              fill={
                bullish
                  ? '#078AC4'
                  : '#123A59'
              }
              stroke={
                bullish
                  ? '#35D8FF'
                  : '#2C7198'
              }
              strokeWidth={
                compact ? 0.9 : 0.95
              }
            />

            <line
              x1={x}
              y1={
                bullish
                  ? shiftedCloseY
                  : shiftedOpenY
              }
              x2={x + candleWidth}
              y2={
                bullish
                  ? shiftedCloseY
                  : shiftedOpenY
              }
              stroke={
                bullish
                  ? '#78E8FF'
                  : '#5795B6'
              }
              strokeWidth={
                compact ? 0.8 : 0.85
              }
              opacity="0.82"
            />
          </g>
        );
      })}
    </svg>
  );
};

