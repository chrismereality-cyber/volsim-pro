const PARTICLES = Array.from({ length: 230 }, (_, index) => {
  const column = index % 23;
  const row = Math.floor(index / 23);

  return {
    id: index,
    x: -20 + column * 34 + ((row * 19) % 25),
    y: 70 + row * 39 + ((column * 23) % 27),
    r:
      index % 19 === 0
        ? 1.5
        : index % 7 === 0
          ? 1
          : 0.55,
    opacity:
      index % 17 === 0
        ? 0.52
        : index % 5 === 0
          ? 0.29
          : 0.14,
  };
