import express from 'express'; import dotenv from 'dotenv';
// Load environment variables from .env
dotenv.config(); const app = express();
// Example route
app.get('/', (req, res) => { res.json({ status: 'Volsim API is running' 
  });
});
// Use port from .env, fallback to 8080
const PORT = process.env.PORT || 8080; app.listen(PORT, () => { 
  console.log(`✅ Volsim API running on port ${PORT}`); 
  console.log(`Try: curl http://127.0.0.1:${PORT}/`);
});
